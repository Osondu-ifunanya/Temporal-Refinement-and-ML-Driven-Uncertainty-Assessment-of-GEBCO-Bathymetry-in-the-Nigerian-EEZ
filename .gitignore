# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.conda/

# Data - do NOT commit large GEBCO grids or generated outputs
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model / figure outputs
outputs/models/*
outputs/figures/*
outputs/tables/*
!outputs/models/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
